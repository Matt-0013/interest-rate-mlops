# ---------------------------------------------------------------------------
# Copy to .env and adjust. .env is git-ignored; never commit real secrets.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=mlops
POSTGRES_PASSWORD=mlops_local_password
POSTGRES_DB=mlops
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Application database (psycopg 3 driver). Use "postgres" as host in Compose.
DATABASE_URL=postgresql+psycopg://mlops:mlops_local_password@localhost:5432/mlops
DATABASE_ECHO=false
ENABLE_DB_PERSISTENCE=true

# --- MLflow ----------------------------------------------------------------
# Client URI. Locally: http://localhost:5000, in Compose: http://mlflow:5000.
# Leave empty to use a local SQLite store (sqlite:///mlruns/mlflow.db).
MLFLOW_TRACKING_URI=http://localhost:5000
# Set only for the MLflow server container (plain postgresql:// uses psycopg2).
MLFLOW_BACKEND_STORE_URI=postgresql://mlops:mlops_local_password@postgres:5432/mlflow
MLFLOW_ARTIFACT_ROOT=/mlflow/artifacts
MODEL_NAME=interest_rate_forecaster
MODEL_ALIAS=champion
MODEL_CACHE_TTL_SECONDS=300

# --- API -------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# --- Airflow ---------------------------------------------------------------
# Generate one: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://mlops:mlops_local_password@postgres:5432/airflow
# Leave empty to keep the DAGs manual-only (static Kaggle dataset).
INGESTION_SCHEDULE=
TRAINING_SCHEDULE=
MONITORING_SCHEDULE=@weekly

# --- Grafana ---------------------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_USERS_ALLOW_SIGN_UP=false
