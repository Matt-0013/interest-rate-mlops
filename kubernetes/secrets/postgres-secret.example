# ---------------------------------------------------------------------------
# TEMPLATE ONLY - this file is deliberately not named *.yaml so that
# `kubectl apply -R -f kubernetes/` skips it.
#
# deploy.sh generates the real Secret from .env (or these local defaults) into
# kubernetes/.generated/postgres-secret.yaml. Nothing here is a production
# credential.
#
# To create it by hand instead:
#   kubectl -n mlops create secret generic postgres-credentials \
#     --from-literal=POSTGRES_USER=mlops \
#     --from-literal=POSTGRES_PASSWORD=mlops_local_password \
#     --from-literal=POSTGRES_DB=mlops \
#     --from-literal=DATABASE_URL='postgresql+psycopg://mlops:mlops_local_password@postgres:5432/mlops' \
#     --from-literal=MLFLOW_BACKEND_STORE_URI='postgresql://mlops:mlops_local_password@postgres:5432/mlflow'
# ---------------------------------------------------------------------------
apiVersion: v1
kind: Secret
metadata:
  name: postgres-credentials
  namespace: mlops
type: Opaque
stringData:
  POSTGRES_USER: mlops
  POSTGRES_PASSWORD: mlops_local_password
  POSTGRES_DB: mlops
  # Application database (psycopg 3 driver, in-cluster service name).
  DATABASE_URL: postgresql+psycopg://mlops:mlops_local_password@postgres:5432/mlops
  # MLflow tracking database (plain postgresql:// uses psycopg2).
  MLFLOW_BACKEND_STORE_URI: postgresql://mlops:mlops_local_password@postgres:5432/mlflow
