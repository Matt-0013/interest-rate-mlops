{
  "uid": "pipeline-monitoring",
  "title": "Pipeline Monitoring",
  "description": "Health of the ingestion, training, promotion and monitoring pipelines as recorded by the pipelines themselves.",
  "tags": ["mlops", "airflow", "pipelines"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-7d", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Last run status",
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "mlops_pipeline_status",
          "legendFormat": "{{pipeline}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "mappings": [
            { "type": "value", "options": { "0": { "text": "failed", "index": 0 } } },
            { "type": "value", "options": { "1": { "text": "ok", "index": 1 } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Time since last success",
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - mlops_pipeline_last_success_timestamp_seconds",
          "legendFormat": "{{pipeline}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "decimals": 0, "noValue": "never" },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Overall monitoring status",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "mlops_monitoring_status" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "mappings": [
            { "type": "value", "options": { "-1": { "text": "unknown", "index": 0 } } },
            { "type": "value", "options": { "0": { "text": "ok", "index": 1 } } },
            { "type": "value", "options": { "1": { "text": "warning", "index": 2 } } },
            { "type": "value", "options": { "2": { "text": "critical", "index": 3 } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 2 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Pipeline duration",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "mlops_pipeline_duration_seconds",
          "legendFormat": "{{pipeline}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 1 }, "overrides": [] }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Last run timestamp",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "mlops_pipeline_last_run_timestamp_seconds",
          "legendFormat": "{{pipeline}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "dateTimeAsIso" }, "overrides": [] }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Retraining recommendation",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "mlops_retrain_recommended",
          "legendFormat": "retrain recommended"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "max": 1,
          "min": 0,
          "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 10 }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Data drift share",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "mlops_data_drift_share", "legendFormat": "drifted feature share" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 2 }, "overrides": [] }
    }
  ]
}
